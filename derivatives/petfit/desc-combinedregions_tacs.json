{
  "sub": {
    "Description": "Subject identifier (numeric part only, without 'sub-' prefix)"
  },
  "ses": {
    "Description": "Session identifier (without 'ses-' prefix)"
  },
  "trc": {
    "Description": "Tracer identifier"
  },
  "rec": {
    "Description": "Reconstruction identifier"
  },
  "task": {
    "Description": "Task identifier"
  },
  "run": {
    "Description": "Run identifier"
  },
  "segmentation": {
    "Description": "Segmentation identifier from preprocessing pipeline"
  },
  "pet": {
    "Description": "PET measurement identifier"
  },
  "bodyweight": {
    "Description": "Body weight of participant for SUV calculation",
    "Units": "kg"
  },
  "region": {
    "Description": "Brain region name (combined from constituent regions)"
  },
  "volume_mm3": {
    "Description": "Total volume of combined regions",
    "Units": "mm3"
  },
  "frame_start": {
    "Description": "Frame start time",
    "Units": "seconds"
  },
  "frame_end": {
    "Description": "Frame end time",
    "Units": "seconds"
  },
  "frame_dur": {
    "Description": "Frame duration",
    "Units": "seconds"
  },
  "frame_mid": {
    "Description": "Frame midpoint time",
    "Units": "seconds"
  },
  "seg_meanTAC": {
    "Description": "Volume-weighted mean TAC across all regions within the segmentation",
    "Units": "kBq/mL"
  },
  "TAC": {
    "Description": "Time Activity Curve value (volume-weighted average)",
    "Units": "kBq/mL"
  },
  "sex": {
    "Description": "Sex of the participant(s)",
    "Levels": {
      "M": "male",
      "F": "female",
      "O": "other"
    }
  },
  "age": {
    "Description": "Age of the participant(s)",
    "Units": "year"
  },
  "weight": {
    "Description": "Weight of the participant(s)",
    "Units": "kg"
  },
  "InjectedRadioactivity": {
    "Description": "Injected radioactivity at time of injection (converted to kBq from original units if necessary)",
    "Units": "kBq"
  },
  "time": {
    "Units": "s"
  },
  "radioactivity": {
    "Units": "kBq/mL"
  }
}
